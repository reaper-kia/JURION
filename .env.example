# Local development only; replace every secret with a distinct value.
PUBLIC_ORIGIN=http://localhost:8000
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8000
REFRESH_COOKIE_SECURE=false
JWT_PRIVATE_KEY_FILE=./.local/jurion-private.pem
JWT_PUBLIC_KEY_FILE=./.local/jurion-public.pem
LEGAL_QA_ARCHIVE=./.local/knowledge-base.zip
# Use URL-safe values (for example, openssl rand -hex 32).
IDENTITY_DB_PASSWORD=local_identity_password_change_me
CONVERSATION_DB_PASSWORD=local_conversation_password_change_me
GATEWAY_IDENTITY_RPC_TOKEN=local_gateway_identity_change_me
GATEWAY_CONVERSATION_RPC_TOKEN=local_gateway_conversation_change_me
GATEWAY_LEGAL_QA_RPC_TOKEN=local_gateway_legal_change_me
CONVERSATION_LEGAL_QA_RPC_TOKEN=local_conversation_legal_change_me
LLM_BASE_URL=http://host.docker.internal:55441
LLM_API_KEY=local_test_key
LLM_MODEL=local_test_model
